# Copy this file to .env and change the password.
# Without NORD_SFTP_HOST, the NORD files are read from data/generated/nord.
NORD_SFTP_HOST=localhost
NORD_SFTP_PORT=2222
NORD_SFTP_USER=nord
NORD_SFTP_PASSWORD=change-me

# Without REIF_API_URL, the REIF files are read from data/generated/reif.
# Start the test API first: uvicorn mock_supplier_api.app:app --port 8001
REIF_API_URL=http://localhost:8001
REIF_API_KEY=demo-key
